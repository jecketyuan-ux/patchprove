{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://patchprove.dev/schema/adapter-v1.json",
  "title": "Patchprove caller-bound adapter envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "adapter",
    "adapterVersion",
    "snapshotHash",
    "inputHash",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "adapter": {
      "enum": [
        "nx",
        "turbo",
        "testmon"
      ]
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1
    },
    "snapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "data": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "plan",
            "run"
          ]
        },
        "dryRun": {
          "type": "boolean"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "version",
            "planHash"
          ],
          "properties": {
            "format": {
              "const": "turbo-task-summary/1"
            },
            "version": {
              "const": "2.5.0"
            },
            "planHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "summaryHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "tasks": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          ]
        },
        "taskGraph": {
          "type": "object"
        },
        "taskResults": {
          "type": "object"
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "tests"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "tests": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
