{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jecketyuan-ux/patchprove/schema/evidence.schema.json",
  "title": "PatchproveEvidence",
  "description": "Versioned evidence pack produced by patchprove run. Model-free: impact, checks, gaps, and risk.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "toolVersion",
    "repo",
    "range",
    "impact",
    "checks",
    "gaps",
    "findings",
    "summary",
    "contract",
    "baselineComparison"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^(1|2)\\.[0-9]+\\.[0-9]+$",
      "description": "Evidence semver: protocol 2 emits 2.0.0; explicit protocol 1 compatibility emits 1.3.0. Readers accept known-major additive fields."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cwd",
        "root"
      ],
      "properties": {
        "cwd": {
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "base",
        "head"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "working-tree",
            "range"
          ]
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changedFiles",
        "mappedTests",
        "unmappedSources",
        "languages",
        "mappingStrategy"
      ],
      "properties": {
        "changedFiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/changedFile"
          }
        },
        "mappedTests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/mappedTest"
          }
        },
        "unmappedSources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "javascript",
              "typescript",
              "python",
              "go",
              "rust",
              "java",
              "other"
            ]
          }
        },
        "mappingStrategy": {
          "type": "string",
          "enum": [
            "naming",
            "coverage",
            "graph"
          ],
          "description": "Primary mapping strategy that produced mappings (coverage if a coverage map was loaded; else graph if import reverse-map produced hits; else naming)."
        },
        "mappingFallbacks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "naming",
              "coverage",
              "graph"
            ]
          },
          "description": "Other strategies that also produced at least one source\u2192test mapping on this run."
        },
        "mappingEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/mappingEvidence"
          }
        },
        "mappingDiagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/diagnostic"
          }
        },
        "unmappedReasons": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/check"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/gap"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk",
        "checksPassed",
        "checksFailed",
        "checksSkipped",
        "gapCount",
        "acceptedGapCount",
        "findingCount"
      ],
      "properties": {
        "risk": {
          "$ref": "#/definitions/summaryRisk"
        },
        "checksPassed": {
          "type": "integer",
          "minimum": 0
        },
        "checksFailed": {
          "type": "integer",
          "minimum": 0
        },
        "checksSkipped": {
          "type": "integer",
          "minimum": 0
        },
        "gapCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Open (non-accepted) gaps. Accepted gaps are counted separately and do not raise risk."
        },
        "acceptedGapCount": {
          "type": "integer",
          "minimum": 0
        },
        "findingCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contract": {
      "$ref": "#/definitions/contract"
    },
    "baselineComparison": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/baselineComparison"
        }
      ]
    },
    "receipt": {
      "$ref": "#/definitions/receiptRef",
      "description": "Optional pointer written after the content hash is computed. Excluded from the hash input."
    },
    "snapshot": {
      "$ref": "#/definitions/snapshot"
    },
    "effectivePolicy": {
      "$ref": "#/definitions/effectivePolicy"
    },
    "verification": {
      "$ref": "#/definitions/verification"
    },
    "executionRecords": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/executionRecord"
      }
    },
    "verificationPlan": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/planItem"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      }
    },
    "mappingEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/mappingEvidence"
      }
    },
    "environment": {
      "$ref": "#/definitions/environment"
    },
    "projectScopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "applicable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "applicable",
          "reason"
        ]
      }
    },
    "resolutionProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parserVersion",
        "inputHash",
        "configurations",
        "resolutions"
      ],
      "properties": {
        "parserVersion": {
          "const": "2"
        },
        "inputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configurations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "hash"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "resolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "specifier",
              "kind",
              "targets"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "specifier": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "builtin",
                  "external",
                  "internal-resolved",
                  "internal-unresolved"
                ]
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "riskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "summaryRisk": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "additions",
        "deletions",
        "highRisk"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "untracked"
          ]
        },
        "additions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        },
        "highRisk": {
          "type": "boolean"
        },
        "riskKind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "lockfile",
            "workflow",
            "auth-crypto",
            null
          ]
        }
      }
    },
    "mappedTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "tests"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "via": {
          "type": "string",
          "enum": [
            "naming",
            "coverage",
            "graph"
          ],
          "description": "How this source was mapped. Present when a coverage map or naming heuristic produced the list."
        },
        "origins": {
          "type": "array",
          "items": {
            "enum": [
              "naming",
              "graph",
              "coverage"
            ]
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "typecheck",
            "lint",
            "tests",
            "secrets"
          ]
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "reason": {
          "type": "string"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "detail": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/executionRecord"
          }
        },
        "timedOut": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "message",
        "risk"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "unmapped-test",
            "no-tests-mapped",
            "tool-missing",
            "unsupported-language",
            "contract",
            "regression"
          ]
        },
        "message": {
          "type": "string"
        },
        "risk": {
          "$ref": "#/definitions/riskLevel"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accepted": {
          "type": "boolean",
          "description": "True when this gap matches acceptGaps or --accept. Visible for audit; excluded from summary risk / fail-on."
        },
        "acceptedReason": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "acceptedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "risk",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "high-risk-path",
            "lockfile",
            "workflow",
            "auth-crypto",
            "secret",
            "check-failed",
            "regression"
          ]
        },
        "risk": {
          "$ref": "#/definitions/riskLevel"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint": {
          "type": "string"
        }
      }
    },
    "contractClause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "passed",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "required-gate",
            "max-residual-risk",
            "required-mapped-tests",
            "forbidden-unproven",
            "accepted-residual-risk"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loaded",
        "passed",
        "source",
        "format",
        "clauses"
      ],
      "properties": {
        "loaded": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "yaml",
            "markdown",
            null
          ]
        },
        "clauses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/contractClause"
          }
        }
      }
    },
    "baselineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "message",
        "risk"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "risk": {
          "$ref": "#/definitions/riskLevel"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      }
    },
    "baselineComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselinePath",
        "newGaps",
        "resolvedGaps",
        "newFindings",
        "resolvedFindings",
        "regression"
      ],
      "properties": {
        "baselinePath": {
          "type": "string"
        },
        "newGaps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/baselineItem"
          }
        },
        "resolvedGaps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/baselineItem"
          }
        },
        "newFindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/baselineItem"
          }
        },
        "resolvedFindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/baselineItem"
          }
        },
        "regression": {
          "type": "boolean"
        },
        "failOnNewGaps": {
          "type": "string",
          "enum": [
            "high",
            "critical"
          ]
        },
        "changedGaps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/baselineItem"
          }
        },
        "changedFindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/baselineItem"
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "compatible": {
              "type": "boolean"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contentHash": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-f]{64}$"
            }
          },
          "required": [
            "compatible",
            "reasons"
          ]
        }
      }
    },
    "receiptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "contentHash"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Canonical SHA-256 of the evidence (timestamps and receipt pointer excluded)."
        },
        "path": {
          "type": "string"
        },
        "previousContentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "unchanged": {
          "type": "boolean"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "message",
        "severity"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "working-tree",
            "range"
          ]
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "mergeBase": {
          "type": [
            "string",
            "null"
          ]
        },
        "currentHead": {
          "type": [
            "string",
            "null"
          ]
        },
        "tree": {
          "type": [
            "string",
            "null"
          ]
        },
        "contentHash": {
          "type": "string",
          "pattern": "^(sha256:)?[0-9a-f]{64}$"
        },
        "patchHash": {
          "type": "string",
          "pattern": "^(sha256:)?[0-9a-f]{64}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "consistent": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "excludedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "algorithm",
        "version",
        "mode",
        "base",
        "head",
        "mergeBase",
        "currentHead",
        "tree",
        "contentHash",
        "patchHash",
        "dirty",
        "consistent"
      ]
    },
    "executionRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "checkId": {
          "enum": [
            "typecheck",
            "lint",
            "tests",
            "secrets"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "cached",
            "imported",
            "timed-out",
            "not-applicable"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        },
        "toolVersion": {
          "type": "string"
        },
        "collectedTests": {
          "type": "integer",
          "minimum": 0
        },
        "signal": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "outputHash": {
          "type": "string",
          "pattern": "^(sha256:)?[0-9a-f]{64}$"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "inputHash": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-f]{64}$"
            },
            "snapshotHash": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-f]{64}$"
            }
          },
          "required": [
            "adapter",
            "version",
            "inputHash"
          ]
        },
        "testExecution": {
          "$ref": "#/definitions/testExecution"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "checkId",
        "scope",
        "status",
        "command",
        "args",
        "cwd",
        "exitCode",
        "durationMs"
      ]
    },
    "planItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "checkId": {
          "enum": [
            "typecheck",
            "lint",
            "tests",
            "secrets"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "unitId": {
          "type": "string"
        },
