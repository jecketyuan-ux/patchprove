{
  "name": "patchprove",
  "version": "2.0.0",
  "description": "Evidence pack for AI/agent patches: impact \u2192 checks \u2192 gaps \u2192 risk.",
  "keywords": [
    "evidence",
    "agent",
    "pr",
    "verification",
    "gap",
    "risk",
    "ci"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "patchprove": "dist/cli.js",
    "patchprove-mcp": "dist/mcp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/evidence.schema.json",
    "./adapter-schema": "./schema/adapter.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "action",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "!docs/reviews/**",
    "!docs/validation/**"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "node dist/mcp.js",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:runtimes": "node scripts/test-runtimes.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:corpus": "node scripts/benchmark-corpus.mjs",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "check:protocol": "node scripts/generate-protocol.mjs --check",
    "test:gitleaks": "node scripts/test-gitleaks.mjs",
    "test:resources": "node scripts/benchmark-resources.mjs",
    "test:projects": "node scripts/benchmark-projects.mjs",
    "test:upstream": "node scripts/test-upstream.mjs",
    "check:acceptance": "node scripts/check-acceptance.mjs",
    "test:acceptance": "node --test scripts/check-acceptance.test.mjs",
    "prepublishOnly": "node scripts/check-acceptance.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jecketyuan-ux/patchprove.git"
  },
  "bugs": {
    "url": "https://github.com/jecketyuan-ux/patchprove/issues"
  },
  "homepage": "https://github.com/jecketyuan-ux/patchprove#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "yaml": "^2.8.1",
    "zod": "^4.5.4",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "ajv-draft-04": "1.0.0",
    "json-schema-to-typescript": "16.0.0",
    "vitest": "4.1.12"
  }
}
